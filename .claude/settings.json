      "PowerShell(npm i)",
      "PowerShell(npm add)",
      "PowerShell(npm --prefix * ci*)",
      "PowerShell(npm --prefix * install*)",
      "PowerShell(npm --prefix * i *)",
      "PowerShell(npm --prefix * i)",
